# =============================================================================
# Padhai — Nepal-First Education Platform
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# -- Supabase --
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -- AI Provider (Gemini) --
GEMINI_API_KEY=your-gemini-api-key

# -- Video Provider (Cloudflare Stream) --
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-cloudflare-stream-api-token

# -- Email (Resend) --
RESEND_API_KEY=your-resend-api-key

# -- Redis (Upstash) --
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# -- App --
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Padhai

# -- Sentry --
SENTRY_DSN=your-sentry-dsn

# -- Zoom Meeting SDK --
ZOOM_MEETING_SDK_KEY=your-zoom-sdk-key
ZOOM_MEETING_SDK_SECRET=your-zoom-sdk-secret
NEXT_PUBLIC_ZOOM_SDK_KEY=your-zoom-sdk-key
